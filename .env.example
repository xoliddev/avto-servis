# Copy this file to .env and fill in your own values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...). The placeholder below is NOT a real token.
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Public HTTPS address of this server, without a trailing slash (for example a free cloudflared tunnel).
# The Mini App "Garaj" opens at https://<address>/webapp/ and Servis pasporti links at https://<address>/webapp/#p=...
# Leave empty to run the bot only (passport links then open in the bot).
PUBLIC_URL=

# Telegram user ids of admins (comma separated): counts and one-time links for new workshops. Find yours with @userinfobot.
ADMIN_IDS=

# Key that signs Servis pasporti links. Any long random text; if empty, one is derived from BOT_TOKEN.
# Changing it makes every existing passport link stop working.
SHARE_SECRET=

# Where the SQLite file lives (the folder is created automatically).
DB_PATH=data/avtoservis.db
# Fill an empty database with the fictional world (7 cars, 3 workshops). 0 = start empty.
# Seeded people have negative ids, so nobody can sign in as them.
SEED_DEMO=1

# Web server for the Mini App and its API.
HOST=0.0.0.0
PORT=8080

# Mini App login data older than this many seconds is refused.
INITDATA_MAX_AGE=3600
# Bot buttons per user per minute, Mini App calls per user per minute, passport page opens per address per minute.
RATE_PER_MINUTE=30
API_RATE_PER_MINUTE=120
PASSPORT_RATE_PER_MINUTE=30
# Set to 1 only behind a reverse proxy you control (then X-Forwarded-For is trusted for the passport rate limit).
TRUST_PROXY=0
LOG_LEVEL=INFO
